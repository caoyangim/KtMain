<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/videoedit_toolbar_title"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/videoedit_empty_hint"
        android:textColor="#B0B0B0"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/emptyContainer"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/videoedit_bg_add_box">

        <ImageView
            android:id="@+id/addButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:contentDescription="@string/videoedit_add"
            android:src="@drawable/videoedit_ic_add" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/resultCard"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/coverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/videoedit_cover_title"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/playButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/videoedit_bg_play"
                android:contentDescription="@string/videoedit_play"
                android:src="@drawable/videoedit_ic_play" />

            <ImageButton
                android:id="@+id/deleteButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/videoedit_bg_delete"
                android:contentDescription="@string/videoedit_delete_title"
                android:src="@drawable/videoedit_ic_delete" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
